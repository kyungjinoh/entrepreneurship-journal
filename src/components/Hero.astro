---
const {
  name = "Kyungjin Oh",
  role = "Entrepreneurship & Engineering Journal",
  now = "Building Cognexa, a revolutionary AI research assistant",
} = Astro.props;

const heroVideos = [
  "/video/hero-1.mp4",
  "/video/hero-2.mp4",
  "/video/hero-3.mp4",
  "/video/hero-4.mp4",
];
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero__bg" aria-hidden="true">
    <video
      class="hero__video"
      autoplay
      muted
      playsinline
      preload="auto"
      poster="/video/hero-poster.png"
      data-sources={JSON.stringify(heroVideos)}
    >
      <source src={heroVideos[0]} type="video/mp4" />
    </video>
    <div class="hero__scrim"></div>
  </div>

  <div class="wrap hero__inner">
    <div class="hero__portrait">
      <div class="hero__ring-plate" aria-hidden="true"></div>
      <div class="hero__ring" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <defs>
            <path
              id="nameRing"
              d="M50,50 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"
            ></path>
          </defs>
          <text textLength="276.4" lengthAdjust="spacing">
            <textPath href="#nameRing" startOffset="0">
              KYUNGJIN OH - KYUNGJIN OH - KYUNGJIN OH - KYUNGJIN OH - KYUNGJIN OH
              - KYUNGJIN OH - KYUNGJIN OH -&#160;
            </textPath>
          </text>
        </svg>
      </div>
      <div class="hero__avatar">
        <img
          src="/profilepic.png"
          alt="Portrait of {name}"
          width="240"
          height="240"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="hero__text">
      <p class="eyebrow hero__role">{role}</p>
      <h1 id="hero-name" class="hero__name">
        {name}<span class="hero__caret" aria-hidden="true"></span>
      </h1>
      <div class="hero__intro">
        <p>
          I build startups and projects and write about how they actually get
          made, including every single decisions, successes, failures, and parts
          that really clicked.
        </p>
        <p class="hero__intro-why">
          I create stuffs
          <br />
          <span class="hero__reason">1)&nbsp;because I love technology and CS</span>
          <br />
          <span class="hero__reason"
            >2)&nbsp;technology I built can bring smile to others.</span
          >
        </p>
      </div>
      <p class="hero__now">
        <span class="hero__now-label">Now</span>
        <span class="hero__now-text">{now}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Nav is fixed (out of flow), so the video background fills from the very
       top; top padding clears the fixed nav for the hero content.
       Keep overall hero height compact so the taller intro copy doesn't stretch
       the video plane. */
    padding-block: calc(var(--nav-h) + clamp(2.75rem, 9vw, 5.5rem))
      clamp(4.5rem, 13vw, 8.5rem);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Poster/video is cool-blue code footage; warm it slightly toward brand. */
    filter: saturate(0.9) contrast(1.02);
  }

  /* Warm-dark scrim guarantees white text clears WCAG AA over the footage. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(20, 18, 16, 0.72) 0%,
        rgba(20, 18, 16, 0.6) 45%,
        rgba(20, 18, 16, 0.78) 100%
      ),
      radial-gradient(
        120% 90% at 15% 20%,
        rgba(194, 90, 30, 0.22) 0%,
        transparent 55%
      );
  }

  .hero__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .hero__portrait {
    position: relative;
    flex: 0 0 auto;
    width: clamp(210px, 30vw, 320px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  /* White band behind the ring text (thijs.gg style). */
  .hero__ring-plate {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.4);
  }

  /* Rotating name ring circling the portrait. */
  .hero__ring {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    animation: ring-spin 26s linear infinite;
  }

  .hero__ring svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hero__ring text {
    font-family: var(--font-mono);
    font-size: 4.9px;
    font-weight: 700;
    letter-spacing: 0.02em;
    fill: var(--ink);
  }

  @keyframes ring-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero__avatar {
    position: relative;
    z-index: 1;
    width: 82%;
    height: 82%;
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: var(--surface);
  }

  .hero__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__text {
    max-width: 42rem;
  }

  .hero__role {
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.82);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero__name {
    font-size: clamp(2.75rem, 8vw, 5.25rem);
    margin-bottom: 0.7rem;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.28);
  }

  /* Blinking terminal-style caret at the end of the name. */
  .hero__caret {
    display: inline-block;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.08em;
    vertical-align: -0.06em;
    background: #fff;
    border-radius: 1px;
    animation: caret-blink 1.05s steps(1) infinite;
  }

  @keyframes caret-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  .hero__intro {
    font-size: clamp(0.95rem, 1.2vw, 1.0625rem);
    color: rgba(255, 255, 255, 0.92);
    max-width: 38rem;
    margin-bottom: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .hero__intro p {
    margin: 0;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hero__intro-why {
    color: rgba(255, 255, 255, 0.88);
  }

  .hero__reason {
    display: inline-block;
    margin-top: 0.12rem;
    padding-left: 0.15rem;
    color: rgba(255, 255, 255, 0.95);
  }

  .hero__now {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
  }

  .hero__now-label {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    background: var(--vermillion);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .hero__now-text {
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 640px) {
    .hero__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Video is paused via script; the poster frame remains as a still image. */
    .hero__video {
      filter: saturate(0.9) contrast(1.02);
    }
    /* Hold the caret solid instead of blinking. */
    .hero__caret {
      animation: none;
      opacity: 1;
    }
    /* Stop the name ring from rotating. */
    .hero__ring {
      animation: none;
    }
  }
</style>

<script>
  // Cycle hero videos 1→2→3→4. Cap each clip at 5s; shorter clips advance on end.
  const video = document.querySelector<HTMLVideoElement>(".hero__video");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const MAX_MS = 5000;
  let timer: number | undefined;
  let index = 0;
  let generation = 0;

  const sources: string[] = (() => {
    try {
      return JSON.parse(video?.dataset.sources ?? "[]");
    } catch {
      return [];
    }
  })();

  const clearTimer = () => {
    if (timer !== undefined) {
      window.clearTimeout(timer);
      timer = undefined;
    }
  };

  const advance = () => {
    show(index + 1);
  };

  const armAdvance = (gen: number) => {
    if (!video || gen !== generation) return;
    clearTimer();

    const durationMs = Number.isFinite(video.duration)
      ? video.duration * 1000
      : MAX_MS;

    if (durationMs > 0 && durationMs < MAX_MS) {
      // Short clip: finish naturally, then move on.
      const onEnded = () => {
        if (gen !== generation) return;
        video.removeEventListener("ended", onEnded);
        advance();
      };
      video.addEventListener("ended", onEnded);
    } else {
      // Long clip (or unknown duration): hard-cut at 5 seconds.
      timer = window.setTimeout(() => {
        if (gen !== generation) return;
        advance();
      }, MAX_MS);
    }
  };

  const show = (i: number) => {
    if (!video || sources.length === 0) return;
    clearTimer();
    generation += 1;
    const gen = generation;

    index = ((i % sources.length) + sources.length) % sources.length;
    const next = sources[index];
    video.loop = false;
    video.src = next;
    video.load();

    const onReady = () => {
      if (gen !== generation) return;
      video.removeEventListener("loadedmetadata", onReady);
      armAdvance(gen);
      video.play().catch(() => {});
    };

    if (video.readyState >= 1) {
      onReady();
    } else {
      video.addEventListener("loadedmetadata", onReady);
    }
  };

  const apply = () => {
    if (!video) return;
    if (reduce.matches) {
      clearTimer();
      generation += 1;
      video.removeAttribute("autoplay");
      video.pause();
    } else {
      show(index);
    }
  };

  apply();
  reduce.addEventListener?.("change", apply);
</script>

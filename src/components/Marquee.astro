---
interface Thumb {
  title: string;
  image: string;
  imageAlt: string;
  href: string;
  coverType?: "image" | "gif" | "video";
}

interface Props {
  items: Thumb[];
}

const { items } = Astro.props;
const track = [...items, ...items];
---

{
  items.length > 0 && (
    <div class="marquee" role="region" aria-label="Build log thumbnails">
      <div class="marquee__track">
        {track.map((item) => (
          <a class="marquee__thumb" href={item.href} title={item.title}>
            {item.coverType === "video" ? (
              <video
                src={item.image}
                muted
                playsinline
                loop
                autoplay
                preload="metadata"
                poster="/images/unity-game-poster.png"
              />
            ) : (
              <img
                src={item.image}
                alt={item.imageAlt}
                width="160"
                height="100"
                loading="lazy"
                decoding="async"
              />
            )}
          </a>
        ))}
      </div>
      <div class="marquee__track" aria-hidden="true">
        {track.map((item) => (
          <a class="marquee__thumb" href={item.href} tabindex="-1">
            {item.coverType === "video" ? (
              <video
                src={item.image}
                muted
                playsinline
                loop
                autoplay
                preload="metadata"
                poster="/images/unity-game-poster.png"
              />
            ) : (
              <img
                src={item.image}
                alt=""
                width="160"
                height="100"
                loading="lazy"
                decoding="async"
              />
            )}
          </a>
        ))}
      </div>
    </div>
  )
}

<style>
  .marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    border-bottom: 1px solid var(--hairline);
    padding-block: 0.75rem;
    margin-block: 0 clamp(1.5rem, 4vw, 2.5rem);
    gap: 0.65rem;
  }

  .marquee__track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.65rem;
    min-width: 100%;
    animation: scroll 40s linear infinite;
    padding-inline: 0.325rem;
  }

  .marquee__thumb {
    flex: 0 0 auto;
    display: block;
    width: clamp(7.5rem, 14vw, 10rem);
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-sunk);
    box-shadow: var(--shadow-rest);
    transition:
      transform var(--dur-mid) var(--ease-out-quart),
      box-shadow var(--dur-mid) var(--ease-out-quart);
  }

  .marquee__thumb:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: var(--shadow-hover);
  }

  .marquee__thumb img,
  .marquee__thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
    .marquee__track + .marquee__track {
      display: none;
    }
    .marquee__thumb:hover {
      transform: none;
    }
  }
</style>

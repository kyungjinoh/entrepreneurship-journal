---
interface Props {
  title: string;
  titleLead?: string;
  summary: string;
  status: "Shipped" | "In Progress";
  image?: string;
  imageAlt?: string;
  coverType?: "image" | "gif" | "video";
  yearLabel?: string;
  showYear?: boolean;
  showStatus?: boolean;
  featured?: boolean;
  href: string;
  variant?: "feature" | "grid";
}

const {
  title,
  titleLead,
  summary,
  status,
  image,
  imageAlt = "",
  coverType = "image",
  yearLabel,
  showYear = true,
  showStatus = true,
  featured = false,
  href,
  variant = "grid",
} = Astro.props;

const lead = titleLead?.trim();
const rest =
  lead && title.startsWith(lead) ? title.slice(lead.length).replace(/^:\s*/, "") : "";
const eager = variant === "feature";
const statusClass =
  status === "In Progress" ? "in-progress" : status.toLowerCase();
---

<article class:list={["card", `card--${variant}`]}>
  <a href={href} class="card__link">
    <div class="card__media">
      {
        coverType === "video" && image ? (
          <video
            class="card__video"
            src={image}
            muted
            playsinline
            loop
            autoplay
            preload="metadata"
            poster="/images/unity-game-poster.png"
          />
        ) : image ? (
          <img
            src={image}
            alt={imageAlt}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
            width="1200"
            height="800"
          />
        ) : (
          <div class="card__placeholder" aria-hidden="true" />
        )
      }
      {
        showYear && yearLabel && (
          <span class="card__year">{yearLabel}</span>
        )
      }
      {
        featured && (
          <span class="card__star" title="Featured">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
              <path
                fill="currentColor"
                d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 18.9 6.2 21l1.1-6.5L2.6 9.9l6.5-.9L12 2.5z"
              />
            </svg>
            <span class="visually-hidden">Featured</span>
          </span>
        )
      }
    </div>

    <div class="card__body">
      {
        showStatus && (
          <div class="card__meta">
            <span
              class:list={["card__status", `card__status--${statusClass}`]}
              >{status}</span
            >
          </div>
        )
      }
      <h3 class="card__title">
        {
          lead && rest ? (
            <>
              <strong class="card__title-lead">{lead}</strong>
              <span class="card__title-rest">: {rest}</span>
            </>
          ) : (
            <strong class="card__title-lead">{title}</strong>
          )
        }
      </h3>
      <p class="card__summary">{summary}</p>
      <span class="card__cta"
        >Read the log <span aria-hidden="true">&rarr;</span></span
      >
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-rest);
    overflow: hidden;
    transition:
      transform var(--dur-mid) var(--ease-out-quart),
      box-shadow var(--dur-mid) var(--ease-out-quart);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card__link:hover {
    text-decoration: none;
    color: inherit;
  }

  .card__media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--surface-sunk);
  }

  .card__media img,
  .card__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease-out-quart);
  }

  .card:hover .card__media img,
  .card:hover .card__video {
    transform: scale(1.04);
  }

  .card__placeholder {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(135deg, #f0ece6 0%, #e7e3dd 50%, #ddd7ce 100%);
  }

  .card__year {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--surface);
    background: var(--vermillion);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .card__star {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--vermillion);
    background: var(--surface);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-rest);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.1rem, 2vw, 1.5rem);
    flex: 1;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
  }

  .card__status {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .card__status--shipped {
    color: #1f6b3a;
    background: #e5f2e9;
  }

  .card__status--in-progress {
    color: var(--burnt-orange);
    background: #f7ece2;
  }

  .card__title {
    font-size: 1.4rem;
    font-weight: 500;
  }

  .card__title-lead {
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .card__title-rest {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .card--feature .card__title-lead {
    font-size: 1.05em;
  }

  .card__summary {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .card__cta {
    margin-top: auto;
    padding-top: 0.4rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--vermillion);
  }

  .card__cta span {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out-quart);
  }

  .card:hover .card__cta span {
    transform: translateX(4px);
  }

  .card--feature .card__title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .card--feature .card__summary {
    font-size: 1.05rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__media img,
    .card__video,
    .card__cta span {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
    .card:hover .card__media img,
    .card:hover .card__video {
      transform: none;
    }
  }
</style>
